default_platform(:ios)

platform :ios do
  desc "Build Flutter iOS IPA and upload to TestFlight"
  lane :beta do

    app_store_connect_api_key(
      key_id: "9W2QUW6M6C",
      issuer_id: "a5176732-64f6-441d-8ed0-0db127470dda",
      key_filepath: "../AuthKeys/AuthKey_9W2QUW6M6C.p8",
      duration: 1200,
      in_house: false
    )

    latest = latest_testflight_build_number(
      app_identifier: "us.antonovich.nextchord"
    )
    next_build = latest.to_i + 1
    UI.message("Latest TestFlight build: #{latest} → Next build: #{next_build}")

    sh("cd .. && flutter pub get")
    sh("cd .. && flutter build ipa --release --build-number=#{next_build}")

    # -------------------------------------------------
    # CORRECT PROJECT ROOT (fastlane runs from ios/fastlane)
    # -------------------------------------------------
    project_root = File.expand_path("../..", Dir.pwd)

    ipa_candidates = Dir.glob(
      File.join(project_root, "build/ios/ipa/*.ipa")
    )

    UI.user_error!("No IPA found in build/ios/ipa") if ipa_candidates.empty?

    ipa_abs = ipa_candidates.first
    UI.message("Uploading IPA: #{ipa_abs}")

    upload_to_testflight(
      ipa: ipa_abs,
      skip_waiting_for_build_processing: true
    )
  end
end
